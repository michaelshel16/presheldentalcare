PORT=3000
NODE_ENV=development
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
ADMIN_SETUP_SECRET=replace_with_a_one_time_bootstrap_secret
CLIENT_ORIGIN=http://localhost:5173

# Optional: configure only if using Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: configure only if sending email notifications
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Preshel Dental Care <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=
